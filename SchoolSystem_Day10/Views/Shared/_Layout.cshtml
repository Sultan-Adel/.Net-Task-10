<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolSystem Identity</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Instructor" asp-action="Index">SchoolSystem</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" asp-controller="Instructor" asp-action="Index">Instructors</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link" asp-controller="Role" asp-action="Index">Roles</a>
                    <a class="nav-link" asp-controller="Role" asp-action="AddRole">Add Role</a>
                    <a class="nav-link" asp-controller="Account" asp-action="AdminRegister">Admin Register User</a>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-light small">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary">Register</a>
                }
            </div>
        </div>
    </nav>
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
