@model IEnumerable<SchoolSystem.Models.Teacher>

@{
    ViewData["Title"] = "Instructors";
}

<h2>Instructors (Authenticated Users Only)</h2>

<table class="table table-bordered table-striped mt-3">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Address</th>
            <th>Department</th>
            <th>Course</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inst in Model)
        {
            <tr>
                <td>@inst.Id</td>
                <td>@inst.Name</td>
                <td>@inst.Address</td>
                <td>@inst.Department?.Name</td>
                <td>@inst.Course?.Name</td>
            </tr>
        }
    </tbody>
</table>
